# Server
PORT=5500
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# IndianAPI.in — https://indianapi.in/indian-stock-market (never expose this key to the frontend)
MARKET_API_BASE_URL=https://stock.indianapi.in
MARKET_API_KEY=

# Cache TTLs (seconds). The free IndianAPI plan has a small request quota,
# so responses are cached (and persisted to backend/.cache) aggressively.
CACHE_TTL_COMPANY=1800
CACHE_TTL_CHART=43200
CACHE_TTL_FORECAST=86400
CACHE_TTL_SEARCH=86400

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
